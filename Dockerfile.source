# From-source multi-stage build for the custom GZCTF image (SolvedMessage feature).
# The upstream src/GZCTF/Dockerfile only packages a pre-published output; this one
# compiles the backend AND the React frontend (triggered by the PublishFrontend
# MSBuild target) entirely inside Docker, since the host has no dotnet/node.
# syntax=docker/dockerfile:1

# Node + pnpm are needed by the PublishFrontend target during `dotnet publish`.
FROM node:22-bookworm-slim AS nodejs

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
# Bring Node (and npm) from the node image into the .NET SDK image, then install pnpm 9
COPY --from=nodejs /usr/local/bin/node /usr/local/bin/node
COPY --from=nodejs /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/npm
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && node --version && npm --version \
 && npm install -g pnpm@10 \
 && pnpm --version

WORKDIR /src
COPY . .
# Release publish compiles C# and runs `pnpm install && pnpm run build` for ClientApp
RUN dotnet publish src/GZCTF/GZCTF.csproj -c Release -o /app/publish /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false \
    LC_ALL=en_US.UTF-8
WORKDIR /app
RUN apk add --update --no-cache wget libpcap icu-data-full icu-libs \
    ca-certificates libgdiplus tzdata krb5-libs && \
    update-ca-certificates
COPY --from=build /app/publish .
EXPOSE 8080
HEALTHCHECK --interval=5m --timeout=3s --start-period=10s --retries=1 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:8080/healthz || exit 1
ENTRYPOINT ["dotnet", "GZCTF.dll"]
